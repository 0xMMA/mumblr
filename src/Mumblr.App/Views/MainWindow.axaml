<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:vm="using:Mumblr.App.ViewModels"
        xmlns:cfg="using:Mumblr.Core.Config"
        x:Class="Mumblr.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="mumblr"
        Icon="avares://mumblr/Assets/mumblr.png"
        Width="1180" Height="720"
        MinWidth="1040" MinHeight="480"
        Background="{StaticResource InkBrush}">

    <DockPanel>

        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">

                <Button Grid.Column="0"
                        Classes="primary"
                        Command="{Binding ToggleRecordingCommand}"
                        IsEnabled="{Binding !IsCommanding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot" Classes.live="{Binding IsRecording}" />
                        <TextBlock Text="{Binding RecordButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Name="CommandButton"
                        Content="Hold to command"
                        ToolTip.Tip="Hold, speak an edit, release. claude -p applies it to the file." />

                <Border Grid.Column="2" Classes="badge"
                        Classes.live="{Binding IsRecording}"
                        Classes.working="{Binding IsCommanding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot"
                                 Classes.live="{Binding IsRecording}"
                                 Classes.working="{Binding IsCommanding}" />
                        <TextBlock Text="{Binding StateLabel}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="MIC" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              MinWidth="220" MaxWidth="300"
                              PlaceholderText="pick a microphone" />
                    <Button Content="&#x21BB;" Command="{Binding RefreshDevicesCommand}" ToolTip.Tip="Rescan devices" />
                </StackPanel>

                <Border Grid.Column="4" Width="90" Height="8" CornerRadius="4"
                        Background="{StaticResource PanelRaisedBrush}" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Level}"
                                 Height="8" CornerRadius="4"
                                 Foreground="{StaticResource GoodBrush}"
                                 Background="Transparent" />
                </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="STT" />
                    <ComboBox ItemsSource="{Binding SttModes}"
                              SelectedItem="{Binding SelectedSttMode}"
                              MinWidth="110"
                              IsEnabled="{Binding !IsRecording}" />
                </StackPanel>

                <Button Grid.Column="7" Content="Copy" Command="{Binding CopyCommand}" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4">
                    <Button Content="Config"
                            Command="{Binding OpenConfigCommand}"
                            ToolTip.Tip="Open config.json - keyterms, dictionary, hotkeys, claude model" />
                    <Button Content="&#x21BB;"
                            Command="{Binding ReloadConfigCommand}"
                            ToolTip.Tip="Reload the config after editing it" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <!-- The facts that answer "is this thing working" without reading a message. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                    <TextBlock Classes="label" Text="{Binding MicrophoneLabel}"
                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding MicrophoneLabel}" />
                    <TextBlock Classes="label" Text="{Binding SttStatusText}" />
                    <TextBlock Classes="label" Text="{Binding CharacterCount, StringFormat='{}{0} chars'}" />
                    <TextBlock Classes="label" Text="{Binding ApiStatusText}"
                               Foreground="{Binding HasApiKey, Converter={x:Static vm:Converters.ApiBrush}}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           ToolTip.Tip="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding IsWarning, Converter={x:Static vm:Converters.WarningBrush}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="label" Text="{Binding HotkeyHint}" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding HotkeyHint}"
                               MaxWidth="300" TextTrimming="CharacterEllipsis" />
                    <Button Content="{Binding VersionButtonText}"
                            Command="{Binding UseVersionButtonCommand}"
                            ToolTip.Tip="{Binding VersionButtonTooltip}"
                            FontSize="11" Padding="8,2" />
                    <Button Content="&lt;/&gt;"
                            Command="{Binding OpenProjectPageCommand}"
                            ToolTip.Tip="Open the project on GitHub"
                            FontFamily="Consolas,Menlo,monospace"
                            FontSize="11" Padding="8,2" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,6,380">

            <!-- channel 1: the dictation buffer -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0" Classes="bar" Padding="12,6" BorderThickness="0,0,0,1">
                    <TextBlock Classes="label mono" Text="{Binding DocumentPath}" TextTrimming="CharacterEllipsis" />
                </Border>

                <ae:TextEditor Grid.Row="1"
                               Name="Editor"
                               Background="{StaticResource InkBrush}"
                               FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                               FontSize="14"
                               ShowLineNumbers="True"
                               WordWrap="True"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Auto"
                               Padding="8" />

                <Border Grid.Row="2" Classes="bar" Padding="12,6" BorderThickness="0,1,0,0"
                        IsVisible="{Binding HasPreview}">
                    <TextBlock Text="{Binding PreviewText}"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Background="{StaticResource HairlineBrush}" />

            <!-- channel 2: commands only, never content -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource HairlineBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label" Text="COMMAND LOG" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Revert last"
                                    Command="{Binding RevertLastCommandCommand}"
                                    IsEnabled="{Binding CanRevert}"
                                    FontSize="11" Padding="8,3" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource HairlineBrush}"
                            IsVisible="{Binding HasPrebuiltCommands}">
                        <ItemsControl ItemsSource="{Binding PrebuiltCommands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="cfg:PrebuiltCommand">
                                    <Button Content="{Binding Label}"
                                            FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunPrebuiltCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsCommanding, Converter={x:Static BoolConverters.Not}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <ScrollViewer Padding="12">
                        <ItemsControl ItemsSource="{Binding CommandLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CommandLogItem">
                                    <Border Classes="card">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Classes="label mono" Text="{Binding Time}" />
                                                <TextBlock Grid.Column="2" Classes="label" Text="{Binding Duration}" />
                                            </Grid>
                                            <TextBlock Text="{Binding CommandText}" TextWrapping="Wrap" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Classes="dot"
                                                         Classes.working="{Binding IsBusy}"
                                                         Classes.live="{Binding IsFailed}" />
                                                <TextBlock Classes="label" Text="{Binding StatusText}" />
                                                <TextBlock Classes="label" Text="{Binding Engine}"
                                                           IsVisible="{Binding Engine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Classes="label" Text="{Binding Source, StringFormat='prebuilt: {0}'}"
                                                           IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Response}"
                                                       IsVisible="{Binding Response, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextDimBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
